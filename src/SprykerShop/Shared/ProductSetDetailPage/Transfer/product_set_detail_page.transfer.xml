<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="ProductSetDataStorage">
        <property name="productAbstractIds" type="array" singular="productAbstractIds"/>
        <property name="name" type="string"/>
        <property name="description" type="string"/>
        <property name="imageSets" singular="imageSet" type="ProductImageSetStorage[]"/>
        <property name="metaDescription" type="string"/>
        <property name="metaKeywords" type="string"/>
    </transfer>

    <transfer name="ProductView">
        <property name="idProductAbstract" type="int"/>
        <property name="attributeMap" type="AttributeMapStorage"/>
        <property name="name" type="string"/>
        <property name="sku" type="string"/>
        <property name="abstractSku" type="string"/>
        <property name="idProductConcrete" type="int"/>
        <property name="available" type="bool"/>
        <property name="prices" type="array" singular="prices"/>
        <property name="abstractName" type="string" description="The name of the abstract product."/>
        <property name="selectedVariantAttributes" type="array" singular="selectedVariantAttribute" description="The super attributes of the concrete product the view shows, attribute key to value, ordered by attribute key as strings, e.g. {&quot;color&quot;: &quot;Red&quot;, &quot;storage_capacity&quot;: &quot;64 GB&quot;}; empty without a concrete product."/>
        <property name="categoryPath" type="string[]" singular="categoryName" description="The category names of the product, top level first, without the root category."/>
        <property name="brand" type="string" description="Brand of the product, the value of its brand attribute; null when it has none."/>
    </transfer>

    <transfer name="AttributeMapStorage">
        <property name="superAttributes" type="array" singular="superAttributes"/>
    </transfer>

    <transfer name="ProductImageSetStorage">
    </transfer>

</transfers>
