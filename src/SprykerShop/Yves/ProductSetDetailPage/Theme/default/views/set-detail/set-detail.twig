{# @var data.set \Generated\Shared\Transfer\ProductSetDataStorageTransfer #}
{# @var _view.productSet \Generated\Shared\Transfer\ProductSetDataStorageTransfer #}

{% extends template('page-layout-main') %}

{% define data = {
    set: _view.productSet,
    views: _view.productViews,
    optionResetUrls: _view.optionResetUrls,

    title: _view.productSet.name,

    metaDescription: _view.productSet.metaDescription,
    metaKeywords: _view.productSet.metaKeywords
} %}

{% block content %}
    {% if widgetExists('ProductSetWidgetPlugin') %}
        {{ widget('ProductSetWidgetPlugin', data.set, data.views) }} {# @deprecated Use organism('product-set-details', 'ProductSetWidget') instead. #}
    {% else %}
        {% include organism('product-set-details', 'ProductSetWidget') ignore missing with {
            data: {
                products: data.views,
                name: data.set.name,
                description: data.set.description,
                images: data.set.imageSets[0].images | default([]),
                optionResetUrls: data.optionResetUrls,
            },
        } only %}
    {% endif %}

    {# The product views carry no category path: the traceable events add it to the tracked products from here, read for the whole set at once. #}
    {% block productTrackingDetails %}
        {% widget 'ProductTrackingDetailsWidget' args [data.views] only %}{% endwidget %}
    {% endblock %}
{% endblock %}

{% block eventTracker %}
    {# The tracking data are built only while the storefront tracks user actions: the traceable event widget is registered and the visitor has not turned the tracking off. #}
    {% set isUserActionTrackingEnabled = findWidget('TraceableEventWidget').parameters.isUserActionTrackingEnabled ?? false %}

    {% set products = [] %}
    {% if isUserActionTrackingEnabled %}
        {% for product in data.views | filter(product => product.idProductConcrete is not empty and product.available) %}
            {% set trackingCategories = [] %}
            {% for categoryName in product.categoryPath | default([]) %}
                {% set trackingCategories = trackingCategories | merge([{ name: categoryName }]) %}
            {% endfor %}
            {% set products = products | merge([{
                sku: product.sku,
                abstractSku: product.abstractSku | default(null),
                name: product.name,
                abstractName: product.abstractName | default(null),
                brand: product.brand | default(null),
                variant: product.selectedVariantAttributes | default([]) | reduce((values, value) => values | merge([value]), []),
                categories: trackingCategories,
                price: can('SeePricePermissionPlugin') ? product.prices.DEFAULT | default : null,
                available: product.available,
            }]) %}
        {% endfor %}
    {% endif %}
    {% set events = {
        list: events.list  | merge([
            {
                event: 'ADD_TO_CART',
                name: 'click',
                triggers: [
                    {
                        selector: '[name="addItemsForm"] button[data-init-single-click]',
                    },
                ],
            }
        ]),
        data: events.data | merge({
            page: 'PDP',
            products: products,
        }),
    } %}

    {{ parent() }}
{% endblock %}
